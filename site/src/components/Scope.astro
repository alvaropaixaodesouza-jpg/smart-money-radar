---
/**
 * The radar scope — the product's name, drawn from its own data.
 *
 * A real scope shows bearing and range, so this does too. The angle around the dial is *when* the
 * first trusted wallet entered: straight up is now, sweeping clockwise into the past. The distance
 * from the centre is conviction inverted — the strongest returns sit locked at the middle, the weak
 * ones drift out toward the rim. Dot size is how many wallets agree.
 *
 * It reads at a glance in a way the ranked list cannot: a cluster near the centre at the top means
 * several strong names were bought in the last hour, and that is the whole point of the page.
 *
 * Everything is drawn with 1px strokes and flat fills — no gradient, no blur, no shadow. The depth
 * comes from graduation: fine ticks, dashed intermediate rings, a stepped sweep trail and target
 * reticles, which is how an instrument earns its density.
 */
import type { Signal } from '../lib/api';

interface Props { signals: Signal[]; hours?: number; size?: number }
const { signals, hours = 24, size = 420 } = Astro.props;

const C = 220;                       // centre of a 440-unit square
const R = 178;                       // outer ring
const RINGS = [R * 0.25, R * 0.5, R * 0.75, R];
const ARC = 300;                     // degrees of dial the window occupies, leaving a gap at 12
const now = Math.floor(Date.now() / 1000);
const windowSec = hours * 3600;
const peak = Math.max(...signals.map((s) => s.conviction), 1);

const rad = (deg: number) => (deg * Math.PI) / 180;
const px = (deg: number, r: number) => [C + r * Math.cos(rad(deg)), C + r * Math.sin(rad(deg))];

/** Most first buys land in the same hour, so bearing alone stacks the returns into one dot.
 *  A deterministic spread from the address separates them without inventing a time. */
function jitter(seed: string): number {
  let h = 0x811c9dc5;
  for (let i = 0; i < seed.length; i++) { h ^= seed.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }
  return ((h % 1000) / 1000 - 0.5) * 22;
}

const plotted = signals.slice(0, 26).map((s) => {
  const age = Math.min(Math.max((now - s.first_ts) / windowSec, 0), 1);
  const deg = -90 + age * ARC + jitter(s.mint);
  const r = 24 + (1 - Math.min(s.conviction / peak, 1)) * (R - 36);
  const [x, y] = px(deg, r);
  return { ...s, deg, r, x, y, dot: Math.min(3 + Math.sqrt(s.buyers) * 1.6, 10), strong: s.conviction >= peak * 0.4 };
});

/** Names go in a contact list rather than on the dial. The strongest returns almost always share a
 *  bearing — they were bought in the same hour — so rim labels stack no matter how they are nudged.
 *  Numbering the contacts and listing them underneath is how a targeting display solves this, and it
 *  leaves room to say something about each one. */
const contacts = plotted.slice(0, 4).map((p, i) => ({ ...p, n: i + 1 }));

// bearing graduations: a long tick every 30 degrees, a short one every 6
const ticks = Array.from({ length: 60 }, (_, i) => i * 6);
// the window's clock, marked where the reader expects to find it
const clock = [0, 0.25, 0.5, 0.75].map((f) => ({
  deg: -90 + f * ARC,
  label: f === 0 ? 'NOW' : `−${Math.round(hours * f)}H`,
}));
// a stepped trail behind the sweep — discrete lines, not a gradient wash
const trail = [4, 9, 15, 22, 30];
---
<figure class="scope" style={`--scope-size:${size}px`}>
  <span class="br tl" /><span class="br tr" /><span class="br bl" /><span class="br rb" />

  <header>
    <span class="ttl">Scope</span>
    <span class="meta">{signals.length} returns · {hours}h sweep</span>
  </header>

  <svg viewBox="0 0 440 440" role="img"
       aria-label={`Radar scope of ${signals.length} tokens. Distance from the centre is conviction, angle is time since the first trusted buy.`}>

    <!-- graduations around the rim -->
    {ticks.map((t) => {
      const long = t % 30 === 0;
      const [x1, y1] = px(t, R + 3);
      const [x2, y2] = px(t, R + (long ? 10 : 6));
      return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke={long ? '#949494' : '#606060'} stroke-width="1" />;
    })}

    <!-- range rings: the outer one solid, the inner ones dashed so range reads as a scale -->
    {RINGS.map((r, i) => (
      <circle cx={C} cy={C} r={r} fill="none"
              stroke={i === RINGS.length - 1 ? '#ffffff' : '#606060'}
              stroke-width="1" stroke-dasharray={i === RINGS.length - 1 ? undefined : '2 5'} />
    ))}

    <!-- bearing spokes -->
    {[0, 45, 90, 135].map((a) => {
      const [x1, y1] = px(a, R);
      const [x2, y2] = px(a + 180, R);
      return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="#606060" stroke-width="1" stroke-dasharray="2 6" />;
    })}

    <!-- the window's clock, outside the graduations so it never competes with a return -->
    {clock.map((c) => {
      const [x, y] = px(c.deg, R + 24);
      return <text x={x} y={y + 3} fill="#949494" text-anchor="middle"
                   font-family="JetBrains Mono, monospace" font-size="8.5" letter-spacing="0.14em">{c.label}</text>;
    })}

    <!-- sweep, with a stepped trail behind it -->
    <g class="sweep" style={`transform-origin:${C}px ${C}px`}>
      {trail.map((d, i) => {
        const [x, y] = px(-90 - d, R);
        return <line x1={C} y1={C} x2={x} y2={y} stroke="#fcff76" stroke-width="1"
                     opacity={(0.30 - i * 0.055).toFixed(2)} />;
      })}
      <line x1={C} y1={C} x2={C} y2={C - R} stroke="#fcff76" stroke-width="1" />
      <circle cx={C} cy={C - R} r="2.5" fill="#fcff76" />
    </g>

    <!-- returns -->
    {plotted.map((p) => (
      <g class="blip">
        {p.strong && <circle cx={p.x} cy={p.y} r={p.dot + 6} fill="none" stroke="#00ff85" stroke-width="1" opacity="0.4" />}
        <circle cx={p.x} cy={p.y} r={p.dot} fill={p.strong ? '#00ff85' : '#ff8a00'} />
      </g>
    ))}

    <!-- the strongest returns get a reticle and a contact number; the names live in the list below -->
    {contacts.map((p) => {
      const b = p.dot + 5;
      return (
        <g class="lock">
          <path d={`M${p.x - b},${p.y - b + 4} v-4 h4 M${p.x + b - 4},${p.y - b} h4 v4
                    M${p.x + b},${p.y + b - 4} v4 h-4 M${p.x - b + 4},${p.y + b} h-4 v-4`}
                stroke="#ffffff" stroke-width="1" fill="none" />
          <text x={p.x + b + 4} y={p.y - b + 1} fill="#ffffff"
                font-family="JetBrains Mono, monospace" font-size="9.5" letter-spacing="0.06em">{p.n}</text>
        </g>
      );
    })}

    <!-- centre crosshair -->
    <line x1={C - 7} y1={C} x2={C + 7} y2={C} stroke="#ffffff" stroke-width="1" />
    <line x1={C} y1={C - 7} x2={C} y2={C + 7} stroke="#ffffff" stroke-width="1" />
  </svg>

  <ol class="contacts">
    {contacts.map((p) => (
      <li>
        <span class="n">{p.n}</span>
        <a class="sym" href={`/token/${p.mint}`}>{p.sym}</a>
        <span class="cv">{p.conviction.toFixed(1)}</span>
        <span class="det">{p.buyers} wallets · avg {p.avg_score.toFixed(0)}</span>
      </li>
    ))}
  </ol>

  <div class="key">
    <span><i class="d strong"></i>conviction &ge; {(peak * 0.4).toFixed(1)}</span>
    <span><i class="d weak"></i>below it</span>
    <span class="axis">bearing = when the first trusted wallet entered</span>
    <span class="axis">range = conviction, strongest at the centre</span>
  </div>
</figure>

<style>
  .scope {
    position: relative;
    margin: 0;
    border: 1px solid #ffffff;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .scope > header {
    display: flex; align-items: baseline; gap: 12px;
    padding: 9px 13px; border-bottom: 1px solid #606060;
  }
  .scope .ttl {
    font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 10px;
    letter-spacing: 0.16em; text-transform: uppercase; color: #fcff76;
  }
  .scope .meta {
    font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 9.5px;
    letter-spacing: 0.08em; color: #606060; margin-left: auto;
  }
  .scope svg {
    width: 100%; height: auto; max-width: var(--scope-size);
    align-self: center; display: block; padding: 10px 12px 4px;
  }
  .contacts {
    list-style: none; margin: 0; padding: 0;
    border-top: 1px solid #606060;
  }
  .contacts li {
    display: grid; grid-template-columns: 18px auto auto 1fr; gap: 10px; align-items: baseline;
    padding: 5px 13px; border-bottom: 1px solid #1c1c1c;
    font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px;
  }
  .contacts li:last-child { border-bottom: 0; }
  .contacts .n { color: #606060; }
  .contacts .sym { color: #ffffff; font-weight: 500; letter-spacing: 0.04em; }
  .contacts .sym:hover { color: #00ff85; text-decoration: none; }
  .contacts .cv { color: #ff8a00; }
  .contacts .det { color: #606060; text-align: right; letter-spacing: 0.04em; }

  .key {
    display: flex; flex-wrap: wrap; gap: 5px 16px; align-items: center;
    border-top: 1px solid #606060; padding: 9px 13px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 9.5px; letter-spacing: 0.06em; color: #949494;
  }
  .key .axis { color: #606060; }
  .key .d {
    display: inline-block; width: 7px; height: 7px; border-radius: 9999px;
    margin-right: 6px; vertical-align: baseline;
  }
  .key .d.strong { background: #00ff85; }
  .key .d.weak { background: #ff8a00; }

  /* corner brackets, the system's section frame */
  .br { position: absolute; width: 10px; height: 10px; pointer-events: none; }
  .tl { top: -1px; left: -1px; border-top: 1px solid #00ff85; border-left: 1px solid #00ff85; }
  .tr { top: -1px; right: -1px; border-top: 1px solid #00ff85; border-right: 1px solid #00ff85; }
  .bl { bottom: -1px; left: -1px; border-bottom: 1px solid #00ff85; border-left: 1px solid #00ff85; }
  .rb { bottom: -1px; right: -1px; border-bottom: 1px solid #00ff85; border-right: 1px solid #00ff85; }

  .sweep { animation: sweep 7s linear infinite; }
  @keyframes sweep { to { transform: rotate(360deg); } }
  .blip { animation: pulse 3.2s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.6; } }
  .lock { animation: lock 3.2s ease-in-out infinite; }
  @keyframes lock { 50% { opacity: 0.75; } }
  @media (prefers-reduced-motion: reduce) {
    .sweep, .blip, .lock { animation: none; }
  }
</style>
