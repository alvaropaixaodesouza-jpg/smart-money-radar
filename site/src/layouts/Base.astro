---
import Logo from '../components/Logo.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  /** Which nav item is current */
  section?: 'signals' | 'fresh' | 'leaderboard' | 'about' | null;
  /** Rendered into og:image alt and the page's own h1 is left to the page */
  noindex?: boolean;
}
const { title, description, section = null, noindex = false } = Astro.props;
const site = Astro.site?.origin ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://fomoradar.xyz').href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {site && <meta property="og:image" content={`${site}/banner.svg`} />}

  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" />
</head>
<body>
  <div class="wrap">
    <header class="masthead">
      <a class="brand" href="/">
        <Logo size={30} />
        <span class="wordmark">FOMO&nbsp;<i>ROBINHOOD</i>&nbsp;RADAR</span>
      </a>
      <nav class="tabs">
        <a href="/" aria-current={section === 'signals' ? 'page' : undefined}>signals</a>
        <a href="/fresh" aria-current={section === 'fresh' ? 'page' : undefined}>fresh</a>
        <a href="/leaderboard" aria-current={section === 'leaderboard' ? 'page' : undefined}>leaderboard</a>
        <a href="/about" aria-current={section === 'about' ? 'page' : undefined}>about</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <span>FOMO Robinhood Radar · read-only research, never trades, not financial advice</span>
      <span>Robinhood Chain · 4663</span>
      <a href="/docs">API</a>
      <a href="https://github.com/">source</a>
    </footer>
  </div>
</body>
</html>
