[Unit]
Description=FOMO Robinhood Radar - window manager for the collector display
After=radar-xvfb.service
Requires=radar-xvfb.service

[Service]
User=radar
Group=radar
Environment=DISPLAY=:99
Environment=HOME=/opt/fomoradar
# Without a window manager Chrome's own dialogs open unfocused and cannot be dismissed over VNC,
# which makes signing in by hand impossible.
ExecStart=/usr/bin/fluxbox
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
