[Unit]
Description=FOMO Robinhood Radar - logged-in Chrome that collects fomo
After=radar-xvfb.service radar-wm.service radar-receive.service
Requires=radar-xvfb.service radar-wm.service

[Service]
User=radar
Group=radar
Environment=DISPLAY=:99
Environment=HOME=/opt/fomoradar
WorkingDirectory=/opt/fomoradar
# Chrome 137 turned --load-extension into a no-op behind a feature flag, so an unpacked extension
# needs that feature switched back off. Verified against Chrome 152: without it the extensions
# page is simply empty and nothing anywhere says why.
#
# Deliberately NOT headless and with no automation flags: headless Chrome announces itself in the
# user agent, and --enable-automation sets navigator.webdriver, which is exactly what Google's
# sign-in refuses. This is an ordinary Chrome that happens to have no physical monitor.
ExecStart=/usr/bin/google-chrome \
  --user-data-dir=/opt/fomoradar/chrome-profile \
  --load-extension=/opt/fomoradar/app/extension \
  --disable-extensions-except=/opt/fomoradar/app/extension \
  --disable-features=DisableLoadExtensionCommandLineSwitch \
  --no-first-run --no-default-browser-check \
  --disable-background-timer-throttling \
  --disable-backgrounding-occluded-windows \
  --disable-renderer-backgrounding \
  --window-size=1280,900 --window-position=0,0 \
  --password-store=basic \
  https://fomo.family/
Restart=always
RestartSec=10
# Chrome writes only inside its own profile; everything else on the box stays read-only to it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/fomoradar
# Chrome needs a writable /tmp for its singleton socket, and ProtectSystem=strict makes the real
# one read-only. A private one satisfies it and keeps the host's /tmp out of reach.
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
